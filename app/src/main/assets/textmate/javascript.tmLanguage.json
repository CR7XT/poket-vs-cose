{
  "scopeName": "source.js",
  "name": "JavaScript",
  "patterns": [
    { "match": "//.*$", "name": "comment.line.double-slash.js" },
    { "begin": "/\\*", "end": "\\*/", "name": "comment.block.js" },
    { "begin": "\"", "end": "\"", "name": "string.quoted.double.js", "patterns": [{ "match": "\\\\.", "name": "constant.character.escape.js" }] },
    { "begin": "'", "end": "'", "name": "string.quoted.single.js", "patterns": [{ "match": "\\\\.", "name": "constant.character.escape.js" }] },
    { "begin": "`", "end": "`", "name": "string.template.js", "patterns": [{ "match": "\\\\.", "name": "constant.character.escape.js" }] },
    { "match": "\\b(true|false|null|undefined|NaN|Infinity)\\b", "name": "constant.language.boolean.js" },
    { "match": "\\b(if|else|switch|case|default|for|while|do|break|continue|return|try|catch|finally|throw|import|export|from|as)\\b", "name": "keyword.control.js" },
    { "match": "\\b(const|let|var|function|class|extends|new|this|super|async|await|typeof|instanceof|void|delete|yield)\\b", "name": "storage.type.js" },
    { "match": "\\b(console|Math|JSON|Promise|Array|Object|Map|Set|Date|RegExp|Error)\\b", "name": "support.class.js" },
    { "match": "\\b[A-Za-z_$][A-Za-z0-9_$]*(?=\\s*\\()", "name": "entity.name.function.js" },
    { "match": "\\b[0-9]+(\\.[0-9]+)?\\b", "name": "constant.numeric.js" }
  ]
}
