{
  "scopeName": "source.css",
  "name": "CSS",
  "patterns": [
    { "begin": "/\\*", "end": "\\*/", "name": "comment.block.css" },
    { "begin": "\"", "end": "\"", "name": "string.quoted.double.css" },
    { "begin": "'", "end": "'", "name": "string.quoted.single.css" },
    { "match": "#[0-9A-Fa-f]{3,8}\\b", "name": "constant.numeric.color.css" },
    { "match": "@[A-Za-z-]+\\b", "name": "keyword.control.at-rule.css" },
    { "match": "\\b[a-z-]+(?=\\s*:)", "name": "support.type.property-name.css" },
    { "match": "[.#][A-Za-z_-][A-Za-z0-9_-]*", "name": "entity.other.attribute-name.css" },
    { "match": "\\b[0-9]+(\\.[0-9]+)?(px|rem|em|%|vh|vw|s|ms)?\\b", "name": "constant.numeric.css" }
  ]
}
