{
  "scopeName": "source.ts",
  "name": "TypeScript",
  "patterns": [
    { "match": "//.*$", "name": "comment.line.double-slash.ts" },
    { "begin": "/\\*", "end": "\\*/", "name": "comment.block.ts" },
    { "begin": "\"", "end": "\"", "name": "string.quoted.double.ts", "patterns": [{ "match": "\\\\.", "name": "constant.character.escape.ts" }] },
    { "begin": "'", "end": "'", "name": "string.quoted.single.ts", "patterns": [{ "match": "\\\\.", "name": "constant.character.escape.ts" }] },
    { "begin": "`", "end": "`", "name": "string.template.ts", "patterns": [{ "match": "\\\\.", "name": "constant.character.escape.ts" }] },
    { "match": "\\b(true|false|null|undefined)\\b", "name": "constant.language.boolean.ts" },
    { "match": "\\b(if|else|switch|case|default|for|while|do|break|continue|return|try|catch|finally|throw|import|export|from|as)\\b", "name": "keyword.control.ts" },
    { "match": "\\b(const|let|var|function|class|interface|type|enum|implements|extends|public|private|protected|readonly|abstract|new|this|super|async|await|keyof|infer)\\b", "name": "storage.type.ts" },
    { "match": "\\b(string|number|boolean|any|unknown|never|void|object|Record|Partial|Promise|Array)\\b", "name": "support.type.ts" },
    { "match": "\\b[A-Za-z_$][A-Za-z0-9_$]*(?=\\s*\\()", "name": "entity.name.function.ts" },
    { "match": "\\b[0-9]+(\\.[0-9]+)?\\b", "name": "constant.numeric.ts" }
  ]
}
